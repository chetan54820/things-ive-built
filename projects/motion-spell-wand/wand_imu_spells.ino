void castSpell() {
  Spell &spell = spells[selectedSpell];

  menuActive = false;
  M5.Display.fillScreen(BLACK);
  drawSpellIcon(spell.name);

  M5.Display.setTextColor(rgb565(spell.r,spell.g,spell.b));
  M5.Display.setTextSize(1);

  int textWidth = strlen(spell.name) * 6;
  M5.Display.setCursor((135-textWidth)/2,112);
  M5.Display.print(spell.name);

  spellLED(spell.name,spell.r,spell.g,spell.b);
  spellSound(spell.name,spell);

  delay(250);
  ledOff();

  // If the battery is getting low, tell the user immediately after the spell.
  readBattery();
  if (!batteryCharging && batteryPercent <= LOW_BATTERY_PERCENT) {
    showLowBatteryWarning();
  }

  drawMenu();
}

// ============================================================
// SETUP / SLEEP / WAKE
// ============================================================

bool sleeping = false;
unsigned long buttonDownAt = 0;
bool longPressHandled = false;

const unsigned long LONG_PRESS_MS = 1000;

void enterSleep() {
  sleeping = true;
  menuActive = false;
  ledOff();
  M5.Speaker.stop();
  M5.Display.fillScreen(BLACK);
  M5.Display.setBrightness(0);
}

void wakeFromSleep() {
  M5.Display.setBrightness(100);
  sleeping = false;

  // Wake screen: Slytherin stays until the button is pressed AGAIN.
  drawSlytherinWake();

  M5.Speaker.tone(659,90);
  delay(80);
  M5.Speaker.tone(988,140);

  while(true) {
    M5.update();

    if(M5.BtnA.wasPressed()) {
      M5.Speaker.stop();
      drawMenu();
      ledOff();
      delay(180);  // don't treat menu-entry press as a cast
      return;
    }

    delay(10);
  }
}

void setup() {
  M5.begin();
  M5.Power.setExtOutput(true);

  led.begin();
  led.setBrightness(100);
  led.clear();
  led.show();

  M5.Speaker.setVolume(255);
  M5.Display.setRotation(8);

  readBattery();

  showBootScreen();

  delay(180); // prevent boot-exit press becoming a cast
  drawMenu();
  setAll(5,5,5);
}

void loop() {
  M5.update();

  // Battery monitoring is lightweight and runs every few seconds.
  updateBattery(true);

  // Sleeping: same front button wakes.
  if(sleeping) {
    if(M5.BtnA.wasPressed()) {
      wakeFromSleep();
    }
    delay(10);
    return;
  }

  // Front button:
  // short press = cast
  // long press = sleep
  if(M5.BtnA.isPressed()) {
    if(buttonDownAt==0) {
      buttonDownAt=millis();
      longPressHandled=false;
    }

    if(!longPressHandled && millis()-buttonDownAt>=LONG_PRESS_MS) {
      longPressHandled=true;
      enterSleep();
      return;
    }
  } else if(buttonDownAt!=0) {
    unsigned long held=millis()-buttonDownAt;
    buttonDownAt=0;

    if(!longPressHandled && held<LONG_PRESS_MS) {
      if(millis()-lastCast>CAST_COOLDOWN) {
        lastCast=millis();
        castSpell();
        return;
      }
    }
  }

  if(!M5.Imu.update()) {
    delay(5);
    return;
  }

  auto data=M5.Imu.getImuData();
  float gy=data.gyro.y;

  if(millis()-lastSelection<SELECTION_COOLDOWN) {
    delay(5);
    return;
  }

  // UP = previous
  if(gy>FLICK_THRESHOLD) {
    lastSelection=millis();
    selectedSpell--;
    if(selectedSpell<0) selectedSpell=SPELL_COUNT-1;
    updateScroll();
    selectionSound();
    drawMenu();
    return;
  }

  // DOWN = next
  if(gy<-FLICK_THRESHOLD) {
    lastSelection=millis();
    selectedSpell++;
    if(selectedSpell>=SPELL_COUNT) selectedSpell=0;
    updateScroll();
    selectionSound();
    drawMenu();
    return;
  }

  delay(5);
}
