void ledOff() {
  setAll(0,0,0);
}

void ledFade(uint8_t r,uint8_t g,uint8_t b,int steps=18,int wait=15) {
  for(int s=1;s<=steps;s++) {
    setAll((uint16_t)r*s/steps,(uint16_t)g*s/steps,(uint16_t)b*s/steps);
    delay(wait);
  }
}

void ledPulse(uint8_t r,uint8_t g,uint8_t b,int pulses=2) {
  for(int p=0;p<pulses;p++) {
    ledFade(r,g,b,14,12);
    for(int s=14;s>=0;s--) {
      setAll((uint16_t)r*s/14,(uint16_t)g*s/14,(uint16_t)b*s/14);
      delay(12);
    }
  }
}

void ledChase(uint8_t r,uint8_t g,uint8_t b,int rounds=2) {
  for(int k=0;k<rounds;k++) {
    for(int i=0;i<LED_COUNT;i++) {
      led.clear();
      led.setPixelColor(i,led.Color(r,g,b));
      if(i>0) led.setPixelColor(i-1,led.Color(r/3,g/3,b/3));
      led.show();
      delay(30);
    }
  }
}

void ledSpark(uint8_t r,uint8_t g,uint8_t b,int bursts=5) {
  for(int k=0;k<bursts;k++) {
    led.clear();
    for(int i=0;i<LED_COUNT;i++)
      if(random(0,3)==0) led.setPixelColor(i,led.Color(r,g,b));
    led.show();
    delay(70);
  }
}

void ledFire() {
  for(int k=0;k<18;k++) {
    for(int i=0;i<LED_COUNT;i++)
      led.setPixelColor(i,led.Color(random(180,256),random(15,90),0));
    led.show();
    delay(45);
  }
}

void spellLED(const char* name, uint8_t r,uint8_t g,uint8_t b) {
  if(!strcmp(name,"LUMOS")) ledPulse(r,g,b,2);
  else if(!strcmp(name,"ALOHOMORA")) ledChase(r,g,b,2);
  else if(!strcmp(name,"EXPELLIARMUS")) ledSpark(r,g,b,6);
  else if(!strcmp(name,"STUPEFY")) ledSpark(r,g,b,8);
  else if(!strcmp(name,"PROTEGO")) ledPulse(r,g,b,3);
  else if(!strcmp(name,"WINGARDIUM")) ledChase(r,g,b,3);
  else if(!strcmp(name,"EXPECTO PATRONUM")) ledPulse(r,g,b,3);
  else if(!strcmp(name,"RIDDIKULUS")) {
    for(int i=0;i<5;i++){ setAll(255,80,180); delay(70); setAll(255,200,60); delay(70); }
  }
  else if(!strcmp(name,"INCENDIO")) ledFire();
  else if(!strcmp(name,"ACCIO")) {
    for(int i=LED_COUNT-1;i>=0;i--) {
      led.clear(); led.setPixelColor(i,led.Color(r,g,b)); led.show(); delay(35);
    }
  }
  else if(!strcmp(name,"IMPERIO")) ledPulse(r,g,b,4);
  else if(!strcmp(name,"CRUCIO")) ledSpark(r,g,b,10);
  else if(!strcmp(name,"AVADA KEDAVRA")) {
    setAll(r,g,b); delay(120);
    for(int s=12;s>=0;s--){ setAll((uint16_t)r*s/12,(uint16_t)g*s/12,(uint16_t)b*s/12); delay(35); }
  }
  else { setAll(r,g,b); delay(300); }
}

