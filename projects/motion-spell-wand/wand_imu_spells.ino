// ============================================================
// BATTERY MONITORING
// ============================================================

const unsigned long BATTERY_UPDATE_MS = 5000;
const int LOW_BATTERY_PERCENT = 15;
const int CRITICAL_BATTERY_PERCENT = 8;

unsigned long lastBatteryCheck = 0;
bool menuActive = false;
int batteryPercent = -1;
int batteryVoltage = 0;
bool batteryCharging = false;

void readBattery() {
  batteryPercent = M5.Power.getBatteryLevel();
  batteryVoltage = M5.Power.getBatteryVoltage();
  batteryCharging = M5.Power.isCharging();
}

void drawBatteryIndicator() {
  // Compact battery icon in the top-right corner of the spell menu.
  int x = 109;
  int y = 3;
  int w = 18;
  int h = 9;

  uint16_t outline = rgb565(170,170,170);
  uint16_t fill;

  if (batteryCharging) {
    fill = rgb565(80,220,255);
  } else if (batteryPercent <= LOW_BATTERY_PERCENT) {
    fill = rgb565(255,70,70);
  } else {
    fill = rgb565(100,230,130);
  }

  M5.Display.drawRect(x, y, w, h, outline);
  M5.Display.fillRect(x+w, y+2, 2, 5, outline);

  int innerW = w - 4;
  int levelW = (batteryPercent < 0) ? 0 :
               (batteryPercent > 100 ? innerW :
               (batteryPercent * innerW) / 100);

  if (levelW > 0)
    M5.Display.fillRect(x+2, y+2, levelW, h-4, fill);

  // Charging indicator: tiny + next to the battery.
  if (batteryCharging) {
    M5.Display.setTextColor(fill);
    M5.Display.setCursor(90, 3);
    M5.Display.print("+");
  }
}

void updateBattery(bool redrawMenuIfNeeded = true) {
  if (millis() - lastBatteryCheck < BATTERY_UPDATE_MS)
    return;

  lastBatteryCheck = millis();

  int oldPercent = batteryPercent;
  bool oldCharging = batteryCharging;

  readBattery();

  if (redrawMenuIfNeeded && menuActive &&
      (oldPercent != batteryPercent || oldCharging != batteryCharging)) {
    drawMenu();
  }
}

void showLowBatteryWarning() {
  readBattery();

  if (batteryCharging || batteryPercent > LOW_BATTERY_PERCENT)
    return;

  M5.Display.fillScreen(BLACK);

  uint16_t warning = rgb565(255,70,70);
  M5.Display.setTextColor(warning);
  M5.Display.setTextSize(1);

  M5.Display.setCursor(34, 70);
  M5.Display.print("LOW BATTERY");

  M5.Display.setTextColor(rgb565(235,235,235));
  M5.Display.setCursor(45, 100);
  M5.Display.printf("%d%%", batteryPercent);

  M5.Display.setCursor(27, 130);
  M5.Display.print("PLEASE CHARGE");

  // Gentle warning pulse rather than a full spell effect.
  for (int i=0; i<2; i++) {
    setAll(255,40,40);
    delay(120);
    ledOff();
    delay(120);
  }

  delay(900);
}

// ============================================================
// HELPERS
// ============================================================

void setAll(uint8_t r, uint8_t g, uint8_t b) {
  for (int i = 0; i < LED_COUNT; i++)
    led.setPixelColor(i, led.Color(r, g, b));
  led.show();
}

uint16_t rgb565(uint8_t r, uint8_t g, uint8_t b) {
  return M5.Display.color565(r, g, b);
}

