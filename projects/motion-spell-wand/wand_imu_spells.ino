void drawNameAtBottom() {
  M5.Display.setTextSize(1);
  M5.Display.setTextColor(rgb565(235,235,235));
  int textWidth = strlen(WIZARD_NAME) * 6;
  M5.Display.setCursor((135 - textWidth) / 2, 222);
  M5.Display.print(WIZARD_NAME);
}

void drawHogwartsBoot() {
  menuActive = false;
  M5.Display.fillScreen(BLACK);
  M5.Display.pushImage(0, 0, 135, 240, hogwartsBoot);
  drawNameAtBottom();
}

void drawSlytherinWake() {
  menuActive = false;
  M5.Display.fillScreen(BLACK);
  M5.Display.pushImage(0, 0, 135, 240, slytherinWake);
  drawNameAtBottom();
}

void playBootMelody() {
  const int notes[] = {
    784, 988, 1175, 1047,
    784, 659, 784, 988,
    1319, 1175, 988, 784,
    659, 784, 587, 784,
    659, 784, 988, 1175
  };
  const int durations[] = {
    180,180,260,180,
    220,180,180,300,
    260,180,220,300,
    220,180,260,500,
    220,180,220,700
  };

  for (int i=0; i<20; i++) {
    M5.update();
    if (M5.BtnA.wasPressed()) {
      M5.Speaker.stop();
      return;
    }
    M5.Speaker.tone(notes[i], durations[i]);
    unsigned long t=millis();
    while (millis()-t < (unsigned long)durations[i]+25) {
      M5.update();
      if (M5.BtnA.wasPressed()) {
        M5.Speaker.stop();
        return;
      }
      delay(5);
    }
  }
}

void showBootScreen() {
  // Cold boot: Hogwarts crest until button press.
  drawHogwartsBoot();
  playBootMelody();

  while (true) {
    M5.update();
    if (M5.BtnA.wasPressed()) {
      M5.Speaker.stop();
      return;
    }
    delay(10);
  }
}

// ============================================================
// MENU
// ============================================================

void drawMenu() {

  menuActive = true;
  M5.Display.fillScreen(BLACK);

  // Header
  M5.Display.setTextSize(1);
  M5.Display.setTextColor(rgb565(255, 255, 255));
  M5.Display.setCursor(47, 3);
  M5.Display.print("SPELLS");

  // Battery status is always visible while using the wand.
  readBattery();
  drawBatteryIndicator();

  // Eight rows fill the usable screen.
  const int startY = 22;
  const int lineHeight = 25;

  for (int i = 0; i < VISIBLE_SPELLS; i++) {

    int spellIndex = scrollOffset + i;
    if (spellIndex >= SPELL_COUNT) break;

    int y = startY + i * lineHeight;

    if (spellIndex == selectedSpell) {
      M5.Display.setTextColor(
        rgb565(spells[spellIndex].r, spells[spellIndex].g, spells[spellIndex].b)
      );
      M5.Display.setTextSize(1);
      M5.Display.setCursor(2, y);
      M5.Display.print("> ");
      M5.Display.println(spells[spellIndex].name);
    } else {
      M5.Display.setTextColor(rgb565(150, 150, 150));
      M5.Display.setTextSize(1);
      M5.Display.setCursor(8, y);
      M5.Display.println(spells[spellIndex].name);
    }
  }

  M5.Display.setTextColor(rgb565(90, 90, 90));

  if (scrollOffset > 0) {
    M5.Display.setCursor(126, 20);
    M5.Display.print("^");
  }

  if (scrollOffset + VISIBLE_SPELLS < SPELL_COUNT) {
    M5.Display.setCursor(126, 214);
    M5.Display.print("v");
  }
}

void updateScroll() {
  if (selectedSpell < scrollOffset)
    scrollOffset = selectedSpell;

  if (selectedSpell >= scrollOffset + VISIBLE_SPELLS)
    scrollOffset = selectedSpell - VISIBLE_SPELLS + 1;

  int maxScroll = SPELL_COUNT - VISIBLE_SPELLS;
  if (maxScroll < 0) maxScroll = 0;

  if (scrollOffset < 0) scrollOffset = 0;
  if (scrollOffset > maxScroll) scrollOffset = maxScroll;
}

void selectionSound() {
  M5.Speaker.tone(1100, 45);
  delay(55);
  M5.Speaker.tone(1400, 35);
}

